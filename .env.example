# Supabase public client configuration
# Crea un proyecto en Supabase y copia estos valores desde Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase recomienda las publishable keys nuevas. Si tu proyecto todavía usa anon key,
# también puedes definir NEXT_PUBLIC_SUPABASE_ANON_KEY como fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública donde corre Nexo. En local normalmente:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
